# Copiar a .env y ajustar los valores.

# Puerto HTTP de la aplicación
PORT=8080

# Conexión a MySQL (DB_HOST=db es el servicio de docker-compose)
DB_HOST=db
DB_PORT=3306
DB_NAME=pokedata
DB_USER=pokedata
DB_PASSWORD=change-me
# Modo TLS: preferred, true, skip-verify o false
DB_TLS=preferred

# Contraseña de root del contenedor MySQL (solo la usa el servicio db)
DB_ROOT_PASSWORD=change-me-root
