# Copiar a .env y ajustar los valores.
# Docker Compose lee este archivo. Para desarrollo local, cambia los hosts
# `db`, `api` y `worker` por 127.0.0.1.

# --- Base de datos -----------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=pokedata
DB_USER=pokedata
DB_PASSWORD=change-me
# Modo TLS: preferred, true, skip-verify o false
DB_TLS=preferred
# Solo la usa el contenedor MariaDB.
DB_ROOT_PASSWORD=change-me-root

# URL que usa el worker (Bun). En local: mysql://pokedata:change-me@127.0.0.1:3306/pokedata
DATABASE_URL=mysql://pokedata:change-me@db:3306/pokedata

# --- API (Go) ----------------------------------------------------------------
# Puerto HTTP público.
PORT=8080
# Token compartido con el worker (mínimo 16 caracteres).
TOKEN_INTERNO=cambia-esto-por-un-token-largo-y-aleatorio
# URL del worker. En local: http://127.0.0.1:7070
URL_WORKER=http://worker:7070
# Servidor interno del worker callback. En local: 127.0.0.1
PUERTO_INTERNO=8081
# En local, 127.0.0.1. Docker Compose lo sobreescribe a 0.0.0.0.
HOST_INTERNO=127.0.0.1
# Secreto para firmar la cookie anónima `sid` (mínimo 32 bytes).
SECRETO_COOKIE=cambia-esto-por-un-secreto-de-al-menos-32-bytes

SIMULACIONES=300
ALEATORIEDAD_RIVAL=0.2
TRABAJOS_SIMULTANEOS_WORKER=2
MAX_PENDIENTES_POR_USUARIO=1
MAX_COLA=200
CACHE_TTL=168h
RETENCION=720h
CANCELAR_SIN_CLIENTE=2m
INTERVALO_SONDEO_SSE=5s
LIMITE_POR_MINUTO=10
# IPs o CIDR de proxies de confianza, separados por comas (vacío = ninguno).
PROXIES_CONFIABLES=

# --- Worker (Bun) ------------------------------------------------------------
# URL base del servidor interno de la API. Nunca el puerto público 8080.
# En local: http://127.0.0.1:8081
URL_CALLBACK=http://api:8081
# IP y puerto del servidor interno del worker. En local, 127.0.0.1; Docker
# Compose lo sobreescribe a 0.0.0.0 para que la API lo alcance.
HOST_WORKER=127.0.0.1
PUERTO=7070
# Hilos de simulación (vacío = núcleos - 1).
HILOS=
TRABAJOS_SIMULTANEOS=2
INTERVALO_SONDEO_MS=1000
INTERVALO_LATIDO_MS=5000
LATIDO_CADUCADO_MS=60000
MAX_INTENTOS=3
TIMEOUT_TAREA_MS=60000
ESPERA_APAGADO_MS=30000

# --- Web / Compose -----------------------------------------------------------
# Puerto publicado para la web en Docker Compose.
WEB_PORT=80
